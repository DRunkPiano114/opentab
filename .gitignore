# Generated Xcode project — regenerate with `xcodegen generate`
*.xcodeproj/
*.xcworkspace/

# Generated from project.yml. Anchored: tools/*/Support holds hand-written files.
/Support/Info.plist
/Support/OpenTab.entitlements

# Build output
build/
.build/
DerivedData/
*.dmg
*.xcresult
*.dSYM

# SwiftPM
.swiftpm/
Package.resolved

# Signing material — never commit
*.p12
*.cer
*.pem
*.p8
*.mobileprovision
*.base64

# macOS
.DS_Store
._*
.AppleDouble

# Editor
*.xcuserdatad
xcuserdata/
.idea/
.vscode/

# Local design/planning notes — not published
runbook/

# Signing-identity stamp written by the Makefile
.cert-stamp

# Probe output: contains real window titles, never commit
tools/*/out*/

# Release artifacts
dist/
*.zip

# Local agent instructions and state — not published
CLAUDE.md
.claude/

# Local secrets
.env
.env.*
